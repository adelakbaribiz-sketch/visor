# This is a convenience copy for people scanning the repo root. The values
# that are actually read live in api/.env.example and web/.env.example
# (the frontend currently reads none — see web/.env.example).
#
# API (api/.env — copy from api/.env.example)
DATABASE_URL="postgresql://visor:visor@localhost:5433/visor?schema=public"
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN_SECONDS=86400
PORT=4100
CORS_ORIGIN="http://localhost:3400"
OPENAI_API_KEY=

# Web (web/.env.local — optional; unused by the app today, see
# docs/ARCHITECTURE.md "Extension point")
NEXT_PUBLIC_API_URL="http://localhost:4100"
